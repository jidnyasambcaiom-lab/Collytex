# Supabase pooled URL for Prisma Client; keep credentials in your local, ignored .env file.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&schema=public"

# Direct/session URL for Prisma schema operations.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require&schema=public"
