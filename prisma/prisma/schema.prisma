generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLATFORM_ADMIN
  COLLEGE_HEAD
  COLLEGE_BRANCH
  STUDENT
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum SectionStatus {
  DRAFT
  PUBLISHED
}

enum BlockType {
  TEXT
  HEADING
  IMAGE
  TABLE
  DROPDOWN
  GRAPH
  LIST
  LINK
  DOCUMENT
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String
  role          Role     @default(STUDENT)
  collegeId     String?
  branchId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  college       College? @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  branch        Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  savedColleges StudentSavedCollege[]
  savedCourses  StudentSavedCourse[]
  auditLogs     AuditLog[]
}

model College {
  id                 String @id @default(cuid())
  name               String
  slug               String @unique
  description        String? @db.Text
  website            String?
  logoUrl            String?
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  branches           Branch[]
  users              User[]
  verifications      Verification[]
  savedBy            StudentSavedCollege[]
}

model Branch {
  id         String @id @default(cuid())
  collegeId  String
  name       String
  slug       String
  city       String
  state      String
  address    String? @db.Text
  isApproved Boolean @default(false)
  createdAt  DateTime @default(now())
  college    College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  users      User[]
  departments Department[]
  @@unique([collegeId, slug])
  @@index([city, state])
}

model Department {
  id       String @id @default(cuid())
  branchId String
  name     String
  slug     String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  offerings DepartmentUniversity[]
  @@unique([branchId, slug])
}

model University {
  id      String @id @default(cuid())
  name    String
  slug    String @unique
  courses DepartmentUniversity[]
}

model DepartmentUniversity {
  id           String @id @default(cuid())
  departmentId String
  universityId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  courses      Course[]
  @@unique([departmentId, universityId])
}

model Course {
  id            String @id @default(cuid())
  offeringId    String
  name          String
  slug          String
  level         String?
  durationYears Int?
  createdAt     DateTime @default(now())
  offering      DepartmentUniversity @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  sections      Section[]
  fees          FeeRecord[]
  cutoffs       CutoffRecord[]
  placements    PlacementRecord[]
  savedBy       StudentSavedCourse[]
  @@unique([offeringId, slug])
}

model Section {
  id          String @id @default(cuid())
  courseId    String
  title       String
  slug        String
  isDefault   Boolean @default(false)
  position    Int
  status      SectionStatus @default(DRAFT)
  publishedAt DateTime?
  course      Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  blocks      Block[]
  @@unique([courseId, slug])
  @@index([courseId, position])
}

model Block {
  id        String @id @default(cuid())
  sectionId String
  type      BlockType
  position  Int
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  @@index([sectionId, position])
}

model FeeRecord {
  id           String @id @default(cuid())
  courseId     String
  academicYear String
  amountPaise  BigInt
  notes        String? @db.Text
  createdAt    DateTime @default(now())
  course       Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@unique([courseId, academicYear])
}

model CutoffRecord {
  id           String @id @default(cuid())
  courseId     String
  academicYear String
  category     String?
  score        Float
  unit         String?
  course       Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@unique([courseId, academicYear, category])
}

model PlacementRecord {
  id                   String @id @default(cuid())
  courseId             String
  academicYear         String
  averagePackagePaise  BigInt?
  highestPackagePaise  BigInt?
  placementPercentage Float?
  studentsPlaced       Int?
  companies            Json?
  course               Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@unique([courseId, academicYear])
}

model StudentSavedCollege {
  userId    String
  collegeId String
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  @@id([userId, collegeId])
}

model StudentSavedCourse {
  userId   String
  courseId String
  createdAt DateTime @default(now())
  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@id([userId, courseId])
}

model Verification {
  id         String @id @default(cuid())
  collegeId  String
  status     VerificationStatus @default(PENDING)
  note       String? @db.Text
  reviewedBy String?
  createdAt  DateTime @default(now())
  reviewedAt DateTime?
  college    College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  @@index([status, createdAt])
}

model AuditLog {
  id         String @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([createdAt])
  @@index([entityType, entityId])
}

model PageView {
  id        String @id @default(cuid())
  path      String
  collegeId String?
  courseId  String?
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([collegeId, createdAt])
  @@index([courseId, createdAt])
}
